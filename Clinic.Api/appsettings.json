{
  // Serilog reads this section (see LoggingServicesExtensions.AddClinicLogging). The sinks are
  // configured in code so the JSON/plain-text choice follows the environment; only levels live here.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        // UseClinicRequestLogging already emits one enriched completion line per request, so the
        // framework's own per-request chatter is pure noise.
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",

  // Origins permitted to call this API from a browser (see the SpaCorsPolicy in Program.cs).
  // These are the Angular dev server's two localhost origins; a deployment overrides the list
  // with Cors__AllowedOrigins__0, Cors__AllowedOrigins__1, ... and must name its real origin -
  // the policy is deliberately not a wildcard.
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "https://localhost:4200" ]
  },

  // JWT:Key is DELIBERATELY ABSENT. It is the root of trust for the entire authentication
  // system - anyone holding it can mint a token for any user with any role - so it must never
  // live in a file that goes into source control.
  //
  // Supply it out of band:
  //   local dev : dotnet user-secrets set "JWT:Key" "<48+ random bytes, base64>" --project Clinic.Api
  //   elsewhere : environment variable  JWT__Key   (double underscore)
  //   production: a managed secret store (Key Vault / Secrets Manager) layered over configuration
  //
  // JwtOptions requires it and is validated with ValidateOnStart, so a missing or too-short key
  // fails the application at startup with a clear message rather than silently issuing 401s.
  "JWT": {
    "Issuer": "http://localhost:5013",
    "Audience": "ClinicApiUsers",
    "ExpireInDays": 2
  },

  // Seed:AdminEmail / Seed:AdminPassword are also absent by design. When they are not configured
  // the seeder does nothing, so no environment ever gets a well-known administrator account.
  // See ClinicIdentityDbContextSeed.

  // These carry no credentials (Windows integrated auth against a local instance), so they stay
  // here for developer convenience. A production deployment must override them via
  // ConnectionStrings__DefaultConnection / ConnectionStrings__IdentityConnection and must NOT
  // use TrustServerCertificate=True, which disables TLS validation on the SQL connection.
  // One connection, one database. IdentityConnection was removed in TODO #23 when the two
  // contexts were merged - identity and clinical records are one logically indivisible dataset
  // and were being backed up, migrated and transacted separately.
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=ClinicDbContext;Trusted_Connection=True;MultipleActiveResultSets=True;TrustServerCertificate=True"
  }
}
